# gpstyle classic
set linetype 1 pt 1 lc rgb "#FF0000"
set linetype 2 pt 2 lc rgb "#0000FF"
set linetype 3 pt 3 lc rgb "#00CC00"
set linetype 4 pt 4 lc rgb "#BF25B2"
set linetype 5 pt 5 lc rgb "#8FAAB3"
set linetype 6 pt 6 lc rgb "#FFA500"
set linetype 7 pt 7 lc rgb "#E51E10"
set linetype 8 pt 8 lc rgb "#000000"
# X = 'LRY' (2)
# Y = 'LRM' (1)
set xlabel 'LRY'
set xzeroaxis
set datafile missing "?"
set logscale y 2
# plot includes automatic fit: OLS
set title 'LRM versus LRY (with least squares fit)'
set ylabel 'LRM'
set key left top
set xrange [5.778955415:6.106797375]
plot \
 '-' using 1:2 notitle w points, \
0.92903091 + 1.818661*x title "Y = 0.929 + 1.82X" w lines
