# gpstyle classic
set linetype 1 pt 1 lc rgb "#FF0000"
set linetype 2 pt 2 lc rgb "#0000FF"
set linetype 3 pt 3 lc rgb "#00CC00"
set linetype 4 pt 4 lc rgb "#BF25B2"
set linetype 5 pt 5 lc rgb "#8FAAB3"
set linetype 6 pt 6 lc rgb "#FFA500"
set linetype 7 pt 7 lc rgb "#E51E10"
set linetype 8 pt 8 lc rgb "#000000"
# multiple timeseries 1
set xtics nomirror 1
set xlabel ''
set xzeroaxis
set datafile missing "?"
set key outside
set xrange [0.875:6.125]
# start literal lines
set title 'Y by group'
set xlabel
# end literal lines
plot \
 '-' using 1:2 title "1" w linespoints, \
 '-' using 1:2 title "2" w linespoints, \
 '-' using 1:2 title "3" w linespoints, \
 '-' using 1:2 title "4" w linespoints, \
